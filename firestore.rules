rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOfficerOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'officer' ||
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (getUserData().role == 'officer' || getUserData().role == 'admin'))
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == 'admin')
      );
    }

    // Users Collection: profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      // Any authenticated citizen, officer, or admin can read civic complaints
      allow read: if isAuthenticated();

      // Citizens can create complaints with required fields
      allow create: if isAuthenticated() &&
        request.resource.data.citizenId != null &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.imageUrl is string &&
        request.resource.data.imageUrl.size() > 0;

      // Updating complaints:
      // Officers/admins can update status, remarks, and assignees
      // Complaint creators can update only if it's in 'Submitted' state
      allow update: if isOfficerOrAdmin() ||
        (isAuthenticated() &&
         resource.data.citizenId == request.auth.uid &&
         resource.data.status == 'Submitted');

      allow delete: if isAdmin();
    }

    // Government Services Collection
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Safety Alerts Collection
    match /safety_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isOfficerOrAdmin();
    }
  }
}
